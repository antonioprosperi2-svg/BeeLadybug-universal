{
  "name": "bee-ladybug",
  "version": "0.6.8",
  "description": "Universal telemetry and visual inspection overlay for Canvas, DOM, Python and AI flows.",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src examples",
    "test": "node --test tests/*.test.js",
    "build:extension": "esbuild extension/content.src.js --bundle --format=iife --platform=browser --target=es2022 --outfile=extension/content.js"
  },
  "keywords": [
    "debug",
    "telemetry",
    "overlay",
    "observability",
    "devtools",
    "canvas",
    "dom",
    "python",
    "websocket",
    "ai",
    "esm"
  ],
  "author": "Antonio Prosperi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antonioprosperi2-svg/BeeLadybug-universal.git"
  },
  "bugs": {
    "url": "https://github.com/antonioprosperi2-svg/BeeLadybug-universal/issues"
  },
  "homepage": "https://github.com/antonioprosperi2-svg/BeeLadybug-universal#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "globals": "^16.0.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
